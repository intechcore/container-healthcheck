# A sample service image which copies the binary in, the way consuming images do.
# The busybox httpd serves a file at /health on port 8080.

ARG HEALTHCHECK_IMAGE=container-healthcheck:test

FROM ${HEALTHCHECK_IMAGE} AS healthcheck

FROM busybox:1.37-musl@sha256:5cec3fc171c87218698e85a52af7087de727372aae264a787b8112901a5b0092

RUN mkdir -p /www && echo OK > /www/health
COPY --from=healthcheck /container-healthcheck /usr/local/bin/container-healthcheck

USER 65534:65534
ENV HEALTHCHECK_PORT=8080
HEALTHCHECK --interval=2s --timeout=3s --start-period=2s --retries=3 CMD ["container-healthcheck"]
ENTRYPOINT ["httpd", "-f", "-p", "8080", "-h", "/www"]
